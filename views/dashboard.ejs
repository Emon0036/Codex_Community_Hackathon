<% layout("Layouts/boilerplate") %>
<section class="container-fluid px-lg-4 page-space dashboard-page">
  <div class="page-heading dashboard-heading d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div><span class="eyebrow">Unified operations command center</span><h1>See pressure before service breaks.</h1><p><%= data.outlet.name %> <span>·</span> <%= data.outlet.area %> <span>·</span> ID <%= data.outlet.id %></p></div>
    <div class="safe-badge"><span class="safe-badge-dot"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span><b>Advisory mode</b><small>Every decision stays human-owned</small></div>
  </div>

  <div class="operations-strip" aria-label="Operational context">
    <div><span><i class="fa-regular fa-clock" aria-hidden="true"></i> Forecast horizon</span><strong>6 hours</strong></div>
    <i></i><div><span><i class="fa-solid fa-rotate" aria-hidden="true"></i> Last synchronized</span><strong><%= new Date(data.outlet.lastSync).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'}) %></strong></div>
    <i></i><div><span><i class="fa-solid fa-signal" aria-hidden="true"></i> Provider feeds</span><strong><%= data.providers.filter(p=>p.feedStatus==='healthy').length %>/<%= data.providers.length %> healthy</strong></div>
    <i></i><div><span><i class="fa-solid fa-code-branch" aria-hidden="true"></i> Analytical mode</span><strong>Net cash flow</strong></div>
  </div>

  <div class="row g-3 metric-grid">
    <div class="col-12 col-sm-6 col-xl-3"><article class="metric-card"><div class="metric-top"><span>Shared physical cash</span><i class="fa-solid fa-money-bill-wave" aria-hidden="true"></i></div><strong>৳<%= data.summary.sharedCash.toLocaleString() %></strong><small>One reserve · never auto-moved</small></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="metric-card"><div class="metric-top"><span>Separate e-money total</span><i class="fa-solid fa-wallet" aria-hidden="true"></i></div><strong>৳<%= data.summary.totalEmoney.toLocaleString() %></strong><small>View only · <%= data.providers.length %> provider ledger<%= data.providers.length===1?'':'s' %></small></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="metric-card warning"><div class="metric-top"><span>Signals requiring review</span><i class="fa-solid fa-bell" aria-hidden="true"></i></div><strong><%= data.summary.openAlerts %></strong><small>Unusual does not mean fraudulent</small></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="metric-card <%= data.cashForecast.shortageHour ? 'warning' : '' %>"><div class="metric-top"><span>Shared-cash coverage</span><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i></div><strong><%= data.summary.coverageHours %>h</strong><small><%= data.cashForecast.shortageHour ? `Pressure projected near hour ${data.cashForecast.shortageHour}` : 'No pressure inside the horizon' %></small></article></div>
  </div>

  <div class="section-title"><div><span class="eyebrow">Provider isolation</span><h2>Separate liquidity positions</h2></div><span class="section-context">Net cash-in and cash-out projection</span></div>
  <div class="row g-3 provider-grid">
    <% data.providers.forEach(provider => { const netChange=provider.forecast.totalReplenishment-provider.forecast.totalDemand; const ending=provider.forecast.projection.at(-1); const runwayPct=Math.round(Math.min(100,ending/Math.max(provider.balance,1)*100)); const providerColumn=data.providers.length===1?'col-12':'col-md-6 col-xl-4'; %>
      <div class="<%= providerColumn %>"><article class="provider-card" style="--provider:<%= provider.color %>">
        <div class="provider-card-head"><div class="provider-name"><i></i><span><%= provider.name %><small>Independent e-money ledger</small></span></div><span class="status <%= provider.forecast.shortageHour ? 'danger' : provider.status %>"><%= provider.forecast.shortageHour ? 'Pressure' : provider.status %></span></div>
        <strong class="provider-balance">৳<%= provider.balance.toLocaleString() %></strong>
        <div class="provider-delta <%= netChange<0?'negative':'positive' %>"><span>Projected 6h net change</span><b><%= netChange>=0?'+':'−' %>৳<%= Math.abs(netChange).toLocaleString() %></b></div>
        <div class="mini-row"><span>Projected closing position</span><b>৳<%= ending.toLocaleString() %></b></div>
        <div class="mini-row"><span>Heuristic confidence</span><b><%= Math.round(provider.forecast.confidence * 100) %>%</b></div>
        <div class="runway-label"><span>Runway retained</span><b><%= runwayPct %>%</b></div>
        <div class="progress thin" role="progressbar" aria-label="<%= provider.name %> projected runway retained" aria-valuenow="<%= runwayPct %>" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:<%= runwayPct %>%;background:<%= provider.color %>"></div></div>
        <div class="provider-foot"><span class="feed-dot <%= provider.feedStatus %>"></span><span><%= provider.feedStatus %> feed · <%= provider.updatedMinutesAgo %>m old</span><b><%= provider.forecast.shortageHour ? `~${provider.forecast.shortageHour}h runway` : '6h clear' %></b></div>
      </article></div>
    <% }) %>
  </div>

  <div class="section-title visualization-title"><div><span class="eyebrow">Forward visibility</span><h2>Runway analysis</h2></div><span class="section-context">Balances shown separately · no conversion implied</span></div>
  <div class="row g-3 visualization-grid">
    <div class="col-xl-8"><article class="glass-card chart-card h-100"><div class="card-heading"><div class="heading-with-icon"><span class="panel-icon"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></span><span><h2>Provider e-money projection</h2><p>Net position after simulated cash-in and cash-out demand</p></span></div><span class="chart-badge">6-hour outlook</span></div><div class="chart-wrap provider-chart-wrap"><canvas id="providerRunwayChart" role="img" aria-label="Separate provider e-money projections over six hours"></canvas></div></article></div>
    <div class="col-xl-4"><article class="glass-card cash-runway-card h-100"><div class="card-heading"><div class="heading-with-icon"><span class="panel-icon"><i class="fa-solid fa-money-bill-transfer" aria-hidden="true"></i></span><span><h2>Shared physical cash</h2><p>Cash-only runway · separate from e-money</p></span></div><span class="status <%= data.cashForecast.shortageHour ? 'danger' : 'resolved' %>"><%= data.cashForecast.shortageHour ? `Hour ${data.cashForecast.shortageHour}` : '6h clear' %></span></div><div class="cash-balance-row"><div><span>Current</span><strong>৳<%= data.outlet.sharedCash.toLocaleString() %></strong></div><div><span>Projected at +5h</span><strong>৳<%= data.cashForecast.projection[4].toLocaleString() %></strong></div></div><div class="chart-wrap cash-chart-wrap"><canvas id="cashRunwayChart" role="img" aria-label="Shared physical cash projection over six hours"></canvas></div><div class="cash-flow-breakdown"><div><span>Cash-out demand</span><b>−৳<%= data.cashForecast.totalDemand.toLocaleString() %></b></div><div><span>Cash-in replenishment</span><b>+৳<%= data.cashForecast.totalReplenishment.toLocaleString() %></b></div><div class="net"><span>Net pressure</span><b>−৳<%= (data.cashForecast.totalDemand-data.cashForecast.totalReplenishment).toLocaleString() %></b></div></div></article></div>
  </div>

  <article class="glass-card signals-panel"><div class="card-heading"><div><span class="eyebrow">Priority queue</span><h2>Signals needing attention</h2><p>Ranked by evidence and heuristic confidence</p></div><a href="/alerts">Open alert workspace <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div><% if(data.alerts.length){ %><div class="dashboard-signal-grid"><% data.alerts.slice(0,4).forEach(alert => { const source=data.providers.find(p=>p.id===alert.provider); %><a class="dashboard-signal" href="/alerts#<%= alert.id %>"><span class="signal-marker <%= alert.severity %>"><i class="fa-solid <%= alert.severity==='high'?'fa-exclamation':'fa-circle-info' %>" aria-hidden="true"></i></span><span class="signal-copy"><small><%= source ? source.name : 'Shared cash' %> · <%= alert.type.replace('-',' ') %></small><b><%= alert.title %></b><em><%= Math.round(alert.confidence*100) %>% heuristic confidence</em></span><span class="signal-arrow"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a><% }) %></div><% } else { %><div class="dashboard-empty-state"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span><b>No open signals in scope</b><small>Continue monitoring feeds and runway; the app will surface review items when evidence changes.</small></span></div><% } %><div class="boundary-note horizontal"><b><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Safety boundary</b><span>Signals support review. They never block accounts, move funds, merge providers, or declare fraud.</span></div></article>
</section>
<script id="dashboard-data" type="application/json" nonce="<%= cspNonce %>"><%- JSON.stringify({labels:data.labels,cash:{name:'Shared physical cash',color:'#5B93B0',values:[data.outlet.sharedCash,...data.cashForecast.projection]},providers:data.providers.map(p=>({name:p.name,color:p.color,values:[p.balance,...p.forecast.projection]}))}).replace(/</g,'\\u003c') %></script>
