<% layout("Layouts/boilerplate") %>
<section class="login-shell demo-entry-shell">
  <div class="login-story">
    <a class="brand login-brand" href="/demo"><span class="brand-mark"><i class="fa-solid fa-wave-square" aria-hidden="true"></i></span><span>Nirapod <b>Ops</b></span></a>
    <span class="eyebrow">Synthetic decision-support prototype</span>
    <h1>Clarity before disruption.</h1>
    <p>Operational decision support for multi-provider agent networks. Explore liquidity pressure, unusual-activity evidence, and human-owned coordination without executing financial action.</p>
    <div class="login-boundaries">
      <span><i class="fa-solid fa-database" aria-hidden="true"></i> Synthetic data</span>
      <span><i class="fa-solid fa-user-check" aria-hidden="true"></i> Human decisions</span>
      <span><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Provider separation</span>
    </div>
  </div>
  <div class="login-panel demo-entry-panel">
    <div>
      <span class="eyebrow">Demo role entry</span>
      <h2>Choose a demo role</h2>
      <p class="muted">Choose a role to explore the existing prototype from that stakeholder’s perspective.</p>
      <% if(error){ %><div class="form-error" role="alert"><%= error %></div><% } %>
      <form action="/demo/role" method="post" class="demo-role-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <fieldset class="demo-role-options">
          <legend class="visually-hidden">Available demo roles</legend>
          <% demoRoles.forEach(role=>{ %>
            <input class="visually-hidden demo-role-input" type="radio" name="role" id="demo-role-<%= role.id %>" value="<%= role.id %>" <%= role.id===selectedRole?'checked':'' %> required>
            <label class="demo-role-card" for="demo-role-<%= role.id %>">
              <span class="demo-role-icon"><i class="fa-solid <%= role.icon %>" aria-hidden="true"></i></span>
              <span class="demo-role-copy"><strong><%= role.label %></strong><small><%= role.description %></small></span>
              <span class="demo-role-check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
            </label>
          <% }) %>
        </fieldset>
        <button class="btn btn-accent" type="submit"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i> Enter demo</button>
      </form>
      <p class="demo-safety-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Demo environment · Synthetic data only · No real financial action</p>
    </div>
  </div>
</section>
