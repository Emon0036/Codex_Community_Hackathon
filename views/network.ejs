<% layout("Layouts/boilerplate") %>
<section class="container-fluid px-lg-4 page-space"><div class="page-heading"><span class="eyebrow">Area-wise prioritization</span><h1>Network readiness across Sylhet.</h1><p>Compare simulated outlets without merging provider authority or balances.</p></div>
  <div class="row g-3 metric-grid"><div class="col-12 col-sm-4"><article class="metric-card"><span>Visible outlets</span><strong><%= network.counts.total %></strong><small>Selected area</small></article></div><div class="col-12 col-sm-4"><article class="metric-card warning"><span>High pressure</span><strong><%= network.counts.high %></strong><small>Prioritize review</small></article></div><div class="col-12 col-sm-4"><article class="metric-card"><span>Watch</span><strong><%= network.counts.watch %></strong><small>Monitor closely</small></article></div></div>
  <form class="filter-bar" method="get" action="/network"><label class="visually-hidden" for="area">Filter by area</label><select class="form-select area-select" id="area" name="area"><option value="all">All areas</option><% network.areas.forEach(area=>{ %><option value="<%= area %>" <%= network.area===area?'selected':'' %>><%= area %></option><% }) %></select><noscript><button class="btn btn-soft">Apply</button></noscript></form>
  <div class="network-grid"><% network.outlets.forEach(outlet=>{ const ratio=Math.min(100,Math.round(outlet.sharedCash/(outlet.sharedCash+outlet.totalEmoney)*100)); %><article class="glass-card outlet-card"><div class="d-flex justify-content-between gap-3"><div><span class="eyebrow"><%= outlet.area %></span><h2><%= outlet.name %></h2><small class="muted"><%= outlet.id %></small></div><span class="status <%= outlet.pressure==='high'?'danger':outlet.pressure %>"><%= outlet.pressure %></span></div><div class="outlet-values"><span>Shared cash <b>৳<%= outlet.sharedCash.toLocaleString() %></b></span><span><%= network.scopeLabel %> <b>৳<%= outlet.totalEmoney.toLocaleString() %></b></span></div><div class="readiness-bar" role="progressbar" aria-label="Cash share of visible value" aria-valuenow="<%= ratio %>" aria-valuemin="0" aria-valuemax="100"><i style="width:<%= ratio %>%"></i></div><small class="muted">Cash share <%= ratio %>% · prioritization indicator only</small></article><% }) %></div>
</section>
