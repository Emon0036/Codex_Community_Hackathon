# Server
PORT=8080
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
PSEUDONYMIZATION_SECRET=replace-with-a-separate-random-secret

# Optional MongoDB persistence. Without this, the app uses an in-memory fallback.
ATLAS_DB=mongodb+srv://username:password@cluster.example/nirapod_ops
MONGODB_DB_NAME=nirapod_ops

# Optional OpenAI bilingual briefing. Never expose this value in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
